---
import { site } from '../config';
import '../styles/tokens.css';
import '../styles/main.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const og = new URL(`${base}og-venzo.png`, Astro.site ?? 'https://example.com').href;
---
<!doctype html>
<html lang={site.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{site.title}</title>
<meta name="description" content={site.description}>
<meta name="theme-color" content="#102824">
<meta name="color-scheme" content="light">
<meta name="generator" content={Astro.generator}>
<!-- Vista previa: no indexar hasta la publicación definitiva. -->
<meta name="robots" content="noindex, nofollow">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={site.title}>
<meta property="og:description" content={site.description}>
<meta property="og:image" content={og}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png">
<link rel="icon" href={`${base}favicon-192.png`} sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<link rel="preload" as="image" href={`${base}venzo-logo-dorado-transparente.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Manrope:wght@400;500;600&display=swap">
<script is:inline>
  /* Se ejecuta antes del primer pintado: fija las clases de movimiento, del telón
     de entrada y del modo de la sección de servicios para que no haya parpadeos.
     Añade ?intro a la URL para volver a ver el telón de entrada. */
  (function () {
    var d = document.documentElement, rm = false, seen = false;
    d.classList.add('js');
    try { rm = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
    if (rm) return;
    d.classList.add('motion');
    try { if (matchMedia('(min-width: 900px) and (min-height: 600px)').matches) d.classList.add('svc-pin'); } catch (e) {}
    try { seen = !!sessionStorage.getItem('venzo-intro-vista'); } catch (e) {}
    if (/[?&]intro\b/.test(location.search)) seen = false;
    if (!seen) d.classList.add('has-intro');
  })();
</script>
</head>
<body>
<slot />
<script>
  import '../scripts/main.js';
</script>
</body>
</html>

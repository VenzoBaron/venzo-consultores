---
import { servicios, dosCifras } from '../data/servicios';
// Composición decorativa de Northlight: una capa por servicio (la delantera es la primera).
const capas = servicios.map((s, i) => ({ ...s, i })).reverse();
const n = servicios.length;
const nombres = servicios.map((s) => s.nombre).join(', ');
---
    <!-- 3. Qué es Venzo -->
    <section id="venzo" class="about" aria-labelledby="about-title">
      <div class="about__grid">
        <div class="about__copy">
          <span class="kicker" data-reveal>Qué es Venzo</span>
          <h2 id="about-title" class="about__title" data-reveal style="--d:.08s">Una visión de conjunto. <em>Un apoyo para cada necesidad.</em></h2>
          <p class="lede about__lede" data-reveal style="--d:.16s">Tu vida no se divide en compartimentos. En Venzo reunimos servicios especializados para ayudarte a encontrar orientación en distintos momentos de tu vida personal y profesional.</p>
        </div>

        <div class="stage-wrap" data-stage-wrap role="img" aria-label={`Capas superpuestas, una por servicio: ${nombres}`}>
          <div class="stage" data-stage aria-hidden="true">
            {capas.map((s, k) => {
              const front = s.i === 0;
              return (
                <div class:list={['plate', { 'plate--front': front }]} data-plate style={`--z:${(k - (n - 1) / 2) * 30}px`}>
                  <span class="plate__top"><span>{dosCifras(s.i)}</span><span>{s.nombre}</span></span>
                  {front
                    ? <span class="plate__foot"><span class="plate__title">Una visión de conjunto.</span><span class="plate__line" style="width:84%"></span></span>
                    : <span class="plate__line" style={`width:${Math.max(28, 84 - s.i * 13)}%`}></span>}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>

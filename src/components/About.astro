---
import { servicios, dosCifras } from '../data/servicios';
// La capa delantera es la primera área; las demás quedan detrás.
const capas = servicios.map((s, i) => ({ ...s, i })).reverse();
const n = servicios.length;
const nombres = servicios.map((s) => s.nombre).join(', ');
---
    <!-- 6. Venzo -->
    <section id="venzo" class="about" aria-labelledby="about-title">
      <div class="about__grid">
        <div class="about__copy">
          <span class="kicker" data-reveal>03 — Venzo</span>
          <h2 id="about-title" class="about__title" data-reveal style="--d:.08s">Un centro. <em>Cada área,</em> en su propio espacio.</h2>
          <p class="lede about__lede" data-reveal style="--d:.16s">Venzo Consultores reúne sus servicios premium en un único punto de partida. Desde aquí descubres cada área y accedes a la web especializada que la desarrolla.</p>
          <div data-reveal style="--d:.24s"><a href="#servicios" class="btn btn-secondary btn-lg" data-magnetic>Explorar servicios</a></div>
        </div>

        <div class="stage-wrap" data-stage-wrap role="img" aria-label={`Capas superpuestas, una por área: ${nombres}`}>
          <div class="stage" data-stage aria-hidden="true">
            {capas.map((s, k) => {
              const z = (k - (n - 1) / 2) * 36;
              const front = s.i === 0;
              return (
                <div class:list={['plate', { 'plate--front': front }]} data-plate style={`--z:${z}px`}>
                  <span class="plate__top"><span>{dosCifras(s.i)}</span><span>{s.nombre}</span></span>
                  {front
                    ? <span class="plate__foot"><span class="plate__title">Un punto de partida.</span><span class="plate__line" style="width:84%"></span></span>
                    : <span class="plate__line" style={`width:${Math.max(30, 84 - (s.i) * 16)}%`}></span>}
                </div>
              );
            })}
          </div>
          <span class="stage-wrap__caption" aria-hidden="true"><span class="caption--hover">Desliza y pasa el cursor para explorar</span><span class="caption--touch">Desliza y toca para explorar</span></span>
        </div>
      </div>
    </section>

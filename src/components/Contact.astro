---
import { site } from '../config';
const { email, telefono } = site.contacto;
const tel = telefono.replace(/[^\d+]/g, '');
---
    <!-- 7. Llamada final. Sin formulario: se añadirá cuando exista un sistema real de envío. -->
    <section id="empezar" class="contact on-dark" aria-labelledby="contact-title">
      <div class="contact__glow" data-glow aria-hidden="true"></div>
      <div class="contact__inner">
        <h2 id="contact-title" class="contact__title" data-reveal="scale"><span>Empieza por</span><span class="accent">tu área.</span></h2>
        <p class="contact__lede" data-reveal style="--d:.12s">Elige un área de servicio y accede a su espacio especializado.</p>
        <div class="contact__ctas" data-reveal style="--d:.2s">
          <a href="#servicios" class="btn btn-primary btn-lg" data-magnetic>Explorar servicios</a>
        </div>
        {(email || telefono) && (
          <div class="contact__lines" data-reveal style="--d:.28s">
            {email && <a href={`mailto:${email}`}>{email}</a>}
            {telefono && <a href={`tel:${tel}`}>{telefono}</a>}
          </div>
        )}
      </div>
    </section>

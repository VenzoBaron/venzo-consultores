---
const pasos = [
  {
    idx: '01 — Explora',
    palabra: 'Explora',
    titulo: 'Recorre las áreas de servicio desde un único lugar.',
    texto: 'Todas las áreas están reunidas en esta página para que puedas compararlas de un vistazo.',
    boton: true,
  },
  {
    idx: '02 — Elige',
    palabra: 'Elige',
    titulo: 'Identifica el área que responde a lo que necesitas.',
    texto: 'Cada área resume en pocas líneas qué ofrece, para que encuentres la tuya sin rodeos.',
  },
  {
    idx: '03 — Accede',
    palabra: 'Accede',
    titulo: 'Entra en su espacio especializado.',
    texto: 'Cada área tiene su propia web. Si todavía no está disponible, lo verás indicado como «Próximamente».',
  },
];
---
    <!-- 5. Cómo funciona -->
    <div class="solutions-wrap on-dark">
    <section id="como-funciona" class="solutions" aria-labelledby="solutions-title" data-reveal-window="0.85 0.45">
      <div class="solutions__head" data-reveal>
        <span class="kicker kicker--light">02 — Cómo funciona</span>
        <h2 id="solutions-title" class="solutions__title">Tres pasos hasta el espacio <em>que buscas.</em></h2>
      </div>

      <ol class="solutions__list">
        {pasos.map((p, i) => (
          <li class:list={['solution', { 'solution--flip': i % 2 === 1 }]}>
            <div class="tile-tilt" data-tilt aria-hidden="true">
              <div class="tile" data-reveal="clip">
                <div class="tile__reveal"><div class="tile__depth" data-depth>
                  <div class="tile__parallax" data-parallax="0.07"><div class="ornament"></div></div>
                  <div class="tile__label"><span class="ornament__frame"></span><span class="ornament__num">{p.palabra}</span></div>
                </div></div>
              </div>
            </div>
            <div class="solution__text">
              <span class="solution__idx tnum" data-reveal>{p.idx}</span>
              <h3 class="solution__title" data-reveal style="--d:.08s">{p.titulo}</h3>
              <p class="lede solution__lede" data-reveal style="--d:.16s">{p.texto}</p>
              {p.boton && <div data-reveal style="--d:.24s"><a href="#servicios" class="btn btn-secondary btn-md" data-magnetic>Ver las áreas</a></div>}
            </div>
          </li>
        ))}
      </ol>
    </section>
    </div>

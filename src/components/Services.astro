---
import { servicios, enlaceDe, romano, dosCifras } from '../data/servicios';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = (src: string) => (src.startsWith('/') ? base + src.slice(1) : src);
const hayEjemplos = servicios.some((s) => s.ejemplo);
const flecha = 'M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z';
---
    <!-- 3. Servicios — en escritorio, tarjetas apiladas que avanzan al desplazarse;
         en móvil y con movimiento reducido, una lista directa. Datos: src/data/servicios.ts -->
    <section id="servicios" class="services on-dark" aria-labelledby="services-title" style={`--n:${servicios.length}`}>
      <div class="services__pin">
        <div class="services__grid">
          <div class="services__intro">
            <div class="services__head">
              <span class="kicker kicker--light">01 — Servicios</span>
              <h2 id="services-title" class="services__title"><span>Encuentra</span><span class="accent">tu área.</span></h2>
              {hayEjemplos && <p class="services__note">Las áreas que se muestran son <strong>ejemplos provisionales</strong>: los servicios definitivos se publicarán próximamente.</p>}
            </div>
            <nav class="services__meta" aria-label="Áreas de servicio">
              <span class="services__bar" aria-hidden="true"><span class="services__bar-fill" data-svc-bar></span></span>
              <ol class="services__index">
                {servicios.map((s, i) => (
                  <li><a href={`#servicio-${s.id}`} class:list={['services__t', { 'is-active': i === 0 }]} data-svc-title><span class="tnum">{dosCifras(i)}</span>{s.nombre}</a></li>
                ))}
              </ol>
            </nav>
          </div>

          <div class="services__stack">
            {servicios.map((s, i) => {
              const url = enlaceDe(s);
              return (
                <article class="svc-card" id={`servicio-${s.id}`} data-card aria-labelledby={`servicio-${s.id}-t`}>
                  <div class="svc-card__media" aria-hidden="true">
                    {s.imagen
                      ? <img class="cover" loading="lazy" decoding="async" alt="" src={img(s.imagen)} />
                      : <div class="ornament"><span class="ornament__frame"></span><span class="ornament__num">{romano(i + 1)}</span></div>}
                  </div>
                  <div class="svc-card__body">
                    <span class="svc-card__idx"><span class="tnum">{dosCifras(i)}</span>{s.ejemplo && <span class="tag">Ejemplo</span>}</span>
                    <h3 class="svc-card__title" id={`servicio-${s.id}-t`}>{s.nombre}</h3>
                    <p class="svc-card__desc">{s.descripcion}</p>
                    {url
                      ? <a href={url} class="btn btn-primary svc-card__btn">Acceder a su web<span class="sr-only">: {s.nombre}</span> <svg width="15" height="15" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d={flecha}/></svg></a>
                      : <span class="soon svc-card__btn">Próximamente</span>}
                  </div>
                  <div class="svc-card__shade" data-shade></div>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </section>

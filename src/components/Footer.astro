---
import { site } from '../config';
import Logo from './Logo.astro';
import { servicios } from '../data/servicios';
const { email, telefono } = site.contacto;
const tel = telefono.replace(/[^\d+]/g, '');
---
    <!-- 4. Pie -->
    <footer class="footer">
      <span class="rule footer__top"></span>
      <div class="footer__cols">
        <div class="footer__brand">
          <Logo variante="verde" class="footer__logo" carga="lazy" />
          <p class="footer__tag">Consultoría 360° · Personas y negocios.</p>
        </div>
        <nav class="footer__col" aria-label="Servicios (pie)">
          <span class="footer__h">Servicios</span>
          {servicios.map((s) => (
            <a href={`#servicio-${s.id}`}>{s.nombre}{s.estado === 'proximamente' && <span class="footer__soon"> · Próximamente</span>}</a>
          ))}
        </nav>
        <nav class="footer__col" aria-label="Secciones">
          <span class="footer__h">Navegación</span>
          <a href="#top">Inicio</a>
          <a href="#servicios">Servicios</a>
          <a href="#venzo">Qué es Venzo</a>
        </nav>
        {(email || telefono) && (
          <div class="footer__col">
            <span class="footer__h">Contacto</span>
            {email && <a href={`mailto:${email}`}>{email}</a>}
            {telefono && <a href={`tel:${tel}`}>{telefono}</a>}
          </div>
        )}
      </div>
      <span class="rule footer__rule"></span>
      <div class="footer__bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>Diseño basado en la plantilla <a href="https://github.com/Sv3nskie/astro-theme-northlight">Northlight</a> de Sv3n (licencia MIT)</span>
      </div>
    </footer>

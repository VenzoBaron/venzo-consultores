---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Value from '../components/Value.astro';
import Services from '../components/Services.astro';
import Statement from '../components/Statement.astro';
import Solutions from '../components/Solutions.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <a class="skip-link" href="#servicios">Saltar a los servicios</a>
  <div class="vh-probe" aria-hidden="true"></div>
  <Intro />
  <Header />
  <MobileMenu />
  <main id="top" class="page">
    <Hero />
    <!-- Todo lo que sigue se desliza por encima de la portada fija -->
    <div id="sheet" class="sheet">
      <Value />
      <Services />
      <Statement />
      <Solutions />
      <About />
      <Contact />
      <Footer />
    </div>
  </main>
</Base>
